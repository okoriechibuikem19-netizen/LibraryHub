# Put these in the backend environment. A .env file is a reference only unless your run configuration loads it.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/libraryhub?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Set these for real email delivery. Obtain credentials from your SMTP provider.
MAIL_ENABLED=true
MAIL_FROM=
# Optional: leave MAIL_FROM blank to send from MAIL_USERNAME.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
SHOW_DEV_OTP=false

# For a local demo without delivery: MAIL_ENABLED=false and SHOW_DEV_OTP=true.

# First administrator
ADMIN_NAME=LibraryHub Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Email provider: smtp (Gmail etc., local) or brevo (required on Render free plan)
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM_NAME=LibraryHub
